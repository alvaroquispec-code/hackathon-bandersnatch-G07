<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>tuckersoft</groupId>
  <artifactId>autotests</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Tuckersoft Autotests</name>
  <description>Bateria de pruebas de la hackathon. NO MODIFICAR.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.3</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Necesario para compilar el listener del resumen. Surefire lo aporta en
         ejecucion, pero no en tiempo de compilacion. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>1.11.3</version>
      <scope>test</scope>
    </dependency>
    <!-- Servidor SMTP embebido: los autotests reciben los correos de verdad
         y comprueban asunto y cuerpo, no solo la fila que el equipo guardo. -->
    <dependency>
      <groupId>com.icegreen</groupId>
      <artifactId>greenmail-junit5</artifactId>
      <version>2.1.3</version>
      <scope>test</scope>
    </dependency>
    <!-- GreenMail registra con SLF4J. Sin un binding imprime "Failed to load class
         StaticLoggerBinder", que parece un error y no lo es. Esto lo silencia. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>1.7.36</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Las clases se llaman CheckpointNNombre, no *Test: sin esto Surefire
               no encuentra ninguna y la corrida pasa en verde sin ejecutar nada. -->
          <includes>
            <include>**/Checkpoint*.java</include>
          </includes>
          <!-- El resumen final lo imprime Resumen.java; Surefire no necesita gritar. -->
          <trimStackTrace>true</trimStackTrace>
          <useFile>false</useFile>
          <redirectTestOutputToFile>false</redirectTestOutputToFile>
          <!-- Un checkpoint roto no debe abortar la corrida: los siguientes se marcan
               como no evaluados y el alumno ve el panorama completo. -->
          <testFailureIgnore>false</testFailureIgnore>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
